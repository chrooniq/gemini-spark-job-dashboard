# Gemini Spark Environment Configuration
# Copy this file to .env and insert your real credentials.

# Job Discovery - RapidAPI JSearch API Key (Required for live multi-platform job aggregation)
RAPIDAPI_KEY=your_rapidapi_key_here

# Transactional Email - Resend API Key (Required for automated 3-hour email reports)
RESEND_API_KEY=your_resend_api_key_here

# Notification Recipient Email
